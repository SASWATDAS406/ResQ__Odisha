# ResQ-Odisha Environment Configuration
# Copy this file to .env and insert your API keys as needed

# AI Multi-Provider Gateway Key (Optional)
# Supports:
# - Google Gemini (starts with 'AIza...')
# - Groq Cloud (starts with 'gsk_...')
# - OpenAI (starts with 'sk-...')
# - Hugging Face (starts with 'hf_...')
# If left empty, ResQ-Odisha operates on its built-in deterministic offline NLP triage engine.
AI_API_KEY=your_ai_api_key_here

# Bhashini ULCA ASR Configuration (Optional - for Odia Voice Recognition)
# Obtain credentials from: https://bhashini.gov.in/ulca/user/register
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_INFERENCE_API_KEY=your_bhashini_inference_key
